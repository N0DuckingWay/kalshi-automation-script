# Credentials — never commit these
kalshi_private_key.pem
kalshi_demo_private_key.pem
kalshi_public_key.pem
kalshi_public_key.pem3
kalshi_public_key_sandbox.pem3
kalshi_private_key_sandbox.pem
secrets.json

# Excel / simulation output
*.xlsx
~$*.xlsx

# Reporter lock/tmp sidecars (BS-18): the sidecar lock file coordinates
# concurrent writers to trade_log.xlsx; the .tmp file is the atomic-save
# staging file, briefly present during a save and renamed away immediately
# after (neither matches *.xlsx since their real extension is .lock/.tmp).
*.xlsx.lock
*.xlsx.tmp

# Bot output
*.log
scheduler_state.json
scheduler_state.json.tmp
# Rotated/suffixed logs (kalshi_backtest.log.prev, .1, .2026-08-03 …) — these do
# NOT match *.log, so without this a `git add -A` sweeps them into a commit.
*.log.*
backtest_cache/
dashboard.html
backtest_dashboard*.html

# Saved live trading defaults (operator state, written by
# config.save_live_defaults when defaults_server's confirmation page is
# confirmed) and the file its atomic save stages beside it; the server's log,
# kalshi_defaults_server.log, is covered by *.log above
live_defaults.json
.live_defaults.json.*.tmp

# A production run's result file (main.py --result-file PATH writes it where
# its caller says, through a staging file beside it). It holds balances and
# trades, so the name the docs use is ignored in case it is written here.
run_result.json
.run_result.json.*.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# macOS
.DS_Store
